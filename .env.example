# Copy this file to ".env" (same directory as wp-config.php) and fill in
# the real values for the current environment. ".env" is git-ignored and
# must be created manually on every environment (local, staging, production).
#
# IMPORTANT on the production/Strato server: ".env" must be uploaded to the
# EXACT same directory where "wp-config.php" is deployed (see
# ".github/workflows/deploy.yml" -> currently the "physio-wojcicki-2026/"
# folder on the webspace), NOT the webspace root. Make sure the uploaded
# file is named exactly ".env" (some FTP/editor tools silently save it as
# ".env.txt" or "env"). If DB_NAME/DB_USER/DB_HOST can't be read from
# ".env", wp-config.php will now stop with an explicit error message
# instead of WordPress's generic "Error establishing a database connection".
#
# IMPORTANT about encoding: always save ".env" as plain "UTF-8" (without a
# byte-order mark/BOM). Some editors (e.g. older Windows Notepad) default to
# "UTF-16" or "ANSI" encoding, which silently corrupts every value (NUL
# bytes end up inside DB_PASSWORD etc.) and causes MySQL to reject the
# connection with "Access denied for user '...' (using password: YES)"
# even though the password looks correct when you read the file.
# wp-config.php now auto-detects/normalizes UTF-16 and a UTF-8 BOM, but
# saving as plain UTF-8 from the start avoids the issue entirely. You can
# verify the uploaded file with: php bin/check-env.php

# Database
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_TABLE_PREFIX=wp_

# WordPress URLs
WP_HOME=http://example.local
WP_SITEURL=http://example.local

# Environment ("local", "staging" or "production")
WP_DEBUG=true
WP_ENVIRONMENT_TYPE=local

# Authentication unique keys and salts.
# Generate a fresh set for every environment at:
# https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=
WP_CACHE_KEY_SALT=
